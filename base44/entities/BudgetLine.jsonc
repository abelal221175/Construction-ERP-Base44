{
  "name": "BudgetLine",
  "type": "object",
  "properties": {
    "budget_id": {
      "type": "string",
      "description": "Reference to project budget"
    },
    "boq_id": {
      "type": "string",
      "description": "Reference to BOQ item"
    },
    "cost_center_id": {
      "type": "string"
    },
    "cost_element_type": {
      "type": "string",
      "enum": [
        "material",
        "subcontractor",
        "labor",
        "equipment",
        "service",
        "indirect"
      ],
      "description": "Cost element type"
    },
    "line_number": {
      "type": "number"
    },
    "description_ar": {
      "type": "string"
    },
    "description_en": {
      "type": "string"
    },
    "budget_quantity": {
      "type": "number",
      "default": 0
    },
    "budget_unit_cost": {
      "type": "number",
      "default": 0
    },
    "budget_amount": {
      "type": "number",
      "default": 0
    },
    "committed_quantity": {
      "type": "number",
      "default": 0
    },
    "committed_amount": {
      "type": "number",
      "default": 0
    },
    "actual_quantity": {
      "type": "number",
      "default": 0
    },
    "actual_amount": {
      "type": "number",
      "default": 0
    },
    "forecast_to_complete": {
      "type": "number",
      "default": 0
    },
    "variance_amount": {
      "type": "number",
      "default": 0
    },
    "variance_percentage": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "budget_id"
  ]
}