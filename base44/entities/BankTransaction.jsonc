{
  "name": "BankTransaction",
  "type": "object",
  "properties": {
    "bank_account_id": {
      "type": "string",
      "description": "Reference to bank account"
    },
    "transaction_date": {
      "type": "string",
      "format": "date"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "deposit",
        "withdrawal",
        "transfer",
        "charge",
        "interest"
      ],
      "default": "deposit"
    },
    "amount": {
      "type": "number"
    },
    "balance_after": {
      "type": "number"
    },
    "reference_type": {
      "type": "string"
    },
    "reference_id": {
      "type": "string"
    },
    "transfer_to_account_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "journal_entry_id": {
      "type": "string"
    },
    "reconciled": {
      "type": "boolean",
      "default": false
    },
    "reconciled_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "bank_account_id",
    "transaction_date",
    "transaction_type",
    "amount"
  ]
}