{
  "name": "SubcontractBOQ",
  "type": "object",
  "properties": {
    "subcontract_id": {
      "type": "string",
      "description": "Reference to subcontract"
    },
    "parent_boq_id": {
      "type": "string",
      "description": "Parent BOQ item for hierarchy"
    },
    "project_boq_id": {
      "type": "string",
      "description": "Reference to project BOQ item"
    },
    "level": {
      "type": "number",
      "description": "Level 1-3"
    },
    "system_code": {
      "type": "string"
    },
    "external_code": {
      "type": "string"
    },
    "item_description": {
      "type": "string",
      "description": "Item description (Arabic/English)"
    },
    "quantity": {
      "type": "number"
    },
    "uom": {
      "type": "string"
    },
    "unit_price": {
      "type": "number"
    },
    "total_amount": {
      "type": "number"
    },
    "cumulative_quantity": {
      "type": "number",
      "default": 0
    },
    "cumulative_amount": {
      "type": "number",
      "default": 0
    },
    "remaining_quantity": {
      "type": "number"
    },
    "remaining_amount": {
      "type": "number"
    },
    "sort_order": {
      "type": "number"
    }
  },
  "required": [
    "subcontract_id",
    "item_description",
    "quantity",
    "unit_price"
  ]
}