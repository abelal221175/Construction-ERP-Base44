{
  "name": "ServiceItem",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to company"
    },
    "item_code": {
      "type": "string",
      "description": "Unique item code"
    },
    "item_name_ar": {
      "type": "string"
    },
    "item_name_en": {
      "type": "string"
    },
    "description_ar": {
      "type": "string"
    },
    "description_en": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "license",
        "municipality",
        "waste_disposal",
        "security",
        "hospitality",
        "cleaning",
        "testing",
        "inspection",
        "other"
      ],
      "description": "Category of service"
    },
    "uom_ar": {
      "type": "string"
    },
    "uom_en": {
      "type": "string"
    },
    "standard_cost": {
      "type": "number"
    },
    "supplier_id": {
      "type": "string",
      "description": "Default supplier for this service"
    },
    "gl_account_id": {
      "type": "string",
      "description": "GL Account for this service"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "item_code",
    "item_name_ar",
    "item_name_en"
  ]
}