{
  "name": "LaborItem",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to company"
    },
    "item_code": {
      "type": "string",
      "description": "Unique labor code"
    },
    "item_name_ar": {
      "type": "string"
    },
    "item_name_en": {
      "type": "string"
    },
    "description_ar": {
      "type": "string"
    },
    "description_en": {
      "type": "string"
    },
    "labor_type": {
      "type": "string",
      "enum": [
        "inhouse",
        "outsource"
      ],
      "default": "inhouse"
    },
    "skill_level": {
      "type": "string",
      "enum": [
        "unskilled",
        "semi_skilled",
        "skilled",
        "supervisor",
        "foreman"
      ],
      "default": "skilled"
    },
    "trade": {
      "type": "string",
      "description": "Trade type e.g. carpenter, mason, electrician"
    },
    "uom_ar": {
      "type": "string",
      "default": "\u064a\u0648\u0645"
    },
    "uom_en": {
      "type": "string",
      "default": "day"
    },
    "hourly_rate": {
      "type": "number"
    },
    "daily_rate": {
      "type": "number"
    },
    "monthly_rate": {
      "type": "number"
    },
    "overtime_multiplier": {
      "type": "number",
      "default": 1.5
    },
    "supplier_id": {
      "type": "string",
      "description": "Supplier for outsourced labor"
    },
    "gl_account_id": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "item_code",
    "item_name_ar",
    "item_name_en"
  ]
}