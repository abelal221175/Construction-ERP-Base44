{"name": "ConstructionProject", "type": "object", "properties": {"job_name": {"type": "string", "description": "Name of the construction job"}, "start_date": {"type": "string", "format": "date", "description": "Project start date"}, "budget": {"type": "number", "description": "Total project budget"}, "current_status": {"type": "string", "enum": ["planning", "in_progress", "on_hold", "completed", "cancelled"], "default": "planning", "description": "Current status of the project"}}, "required": ["job_name", "start_date", "budget", "current_status"]}