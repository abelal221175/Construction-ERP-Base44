{
  "name": "Permission",
  "type": "object",
  "properties": {
    "module_name": {
      "type": "string",
      "description": "Module identifier"
    },
    "module_name_ar": {
      "type": "string"
    },
    "module_name_en": {
      "type": "string"
    },
    "action_name": {
      "type": "string",
      "enum": [
        "view",
        "create",
        "edit",
        "delete",
        "approve",
        "post",
        "print",
        "export"
      ]
    },
    "description_ar": {
      "type": "string"
    },
    "description_en": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "module_name",
    "action_name"
  ]
}