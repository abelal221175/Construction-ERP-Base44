{
  "name": "CostElementType",
  "type": "object",
  "properties": {
    "element_code": {
      "type": "string",
      "description": "Unique element code"
    },
    "element_name_ar": {
      "type": "string",
      "description": "Element name in Arabic"
    },
    "element_name_en": {
      "type": "string",
      "description": "Element name in English"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "element_code",
    "element_name_ar",
    "element_name_en"
  ]
}