{
  "name": "ClientIPC",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to company"
    },
    "project_id": {
      "type": "string",
      "description": "Reference to project"
    },
    "ipc_number": {
      "type": "string",
      "description": "Unique IPC number"
    },
    "ipc_date": {
      "type": "string",
      "format": "date"
    },
    "period_from": {
      "type": "string",
      "format": "date"
    },
    "period_to": {
      "type": "string",
      "format": "date"
    },
    "ipc_sequence": {
      "type": "number",
      "description": "IPC sequence number (1, 2, 3...)"
    },
    "cumulative_gross_amount": {
      "type": "number"
    },
    "previous_certified_amount": {
      "type": "number"
    },
    "current_gross_amount": {
      "type": "number",
      "description": "Calculated: cumulative - previous"
    },
    "retention_percentage": {
      "type": "number"
    },
    "retention_amount": {
      "type": "number"
    },
    "advance_recovery_amount": {
      "type": "number",
      "default": 0
    },
    "other_deductions": {
      "type": "number",
      "default": 0
    },
    "total_deductions": {
      "type": "number"
    },
    "materials_on_site": {
      "type": "number",
      "default": 0
    },
    "other_additions": {
      "type": "number",
      "default": 0
    },
    "total_additions": {
      "type": "number"
    },
    "vat_percentage": {
      "type": "number",
      "default": 14
    },
    "vat_amount": {
      "type": "number"
    },
    "net_payable_amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "certified",
        "invoiced",
        "paid"
      ],
      "default": "draft"
    },
    "notes_ar": {
      "type": "string"
    },
    "notes_en": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "project_id",
    "ipc_number",
    "ipc_date",
    "period_from",
    "period_to",
    "ipc_sequence"
  ]
}