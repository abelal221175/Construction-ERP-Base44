{
  "name": "SiteProgressReport",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to company"
    },
    "report_number": {
      "type": "string",
      "description": "Unique report number"
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "project_id": {
      "type": "string",
      "description": "Reference to project"
    },
    "reported_by": {
      "type": "string",
      "description": "User or employee id"
    },
    "reported_by_name": {
      "type": "string"
    },
    "shift": {
      "type": "string",
      "enum": [
        "day",
        "night"
      ],
      "default": "day"
    },
    "weather": {
      "type": "string",
      "enum": [
        "sunny",
        "cloudy",
        "rainy",
        "windy",
        "foggy"
      ],
      "description": "Weather conditions on site"
    },
    "temperature": {
      "type": "number"
    },
    "work_summary": {
      "type": "string",
      "description": "Summary of work performed"
    },
    "progress_percentage": {
      "type": "number",
      "default": 0
    },
    "manpower_count": {
      "type": "number",
      "default": 0
    },
    "labor_summary": {
      "type": "string",
      "description": "Trades and headcount summary"
    },
    "equipment_summary": {
      "type": "string",
      "description": "Equipment used on site"
    },
    "materials_summary": {
      "type": "string"
    },
    "issues_delays": {
      "type": "string",
      "description": "Issues or delays encountered"
    },
    "safety_incidents": {
      "type": "number",
      "default": 0
    },
    "photos": {
      "type": "string",
      "description": "JSON array of photo URLs"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "rejected"
      ],
      "default": "submitted"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "report_date",
    "project_id",
    "work_summary"
  ]
}