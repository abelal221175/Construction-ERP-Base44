{
  "name": "IPCDeductionAddition",
  "type": "object",
  "properties": {
    "ipc_id": {
      "type": "string",
      "description": "Reference to IPC (Client or Subcontractor)"
    },
    "ipc_type": {
      "type": "string",
      "enum": [
        "client",
        "subcontractor"
      ],
      "description": "Type of IPC"
    },
    "type": {
      "type": "string",
      "enum": [
        "deduction",
        "addition"
      ],
      "description": "Deduction or Addition"
    },
    "category": {
      "type": "string",
      "enum": [
        "retention",
        "advance_recovery",
        "penalty",
        "insurance",
        "backcharge",
        "discount",
        "variation",
        "escalation",
        "materials_on_site",
        "other"
      ],
      "description": "Category of deduction/addition"
    },
    "description_ar": {
      "type": "string"
    },
    "description_en": {
      "type": "string"
    },
    "is_percentage": {
      "type": "boolean",
      "default": false,
      "description": "Whether amount is calculated from percentage"
    },
    "percentage": {
      "type": "number",
      "description": "Percentage if is_percentage is true"
    },
    "amount": {
      "type": "number",
      "description": "Fixed amount or calculated from percentage"
    },
    "reference": {
      "type": "string",
      "description": "Reference document (VO number, etc.)"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "ipc_id",
    "ipc_type",
    "type",
    "category"
  ]
}