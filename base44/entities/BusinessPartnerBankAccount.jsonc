{
  "name": "BusinessPartnerBankAccount",
  "type": "object",
  "properties": {
    "bp_id": {
      "type": "string",
      "description": "Reference to business partner"
    },
    "bank_name_ar": {
      "type": "string"
    },
    "bank_name_en": {
      "type": "string"
    },
    "branch_name": {
      "type": "string"
    },
    "account_number": {
      "type": "string"
    },
    "iban": {
      "type": "string"
    },
    "swift_code": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "EGP"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "bp_id",
    "account_number"
  ]
}