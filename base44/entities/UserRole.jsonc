{
  "name": "UserRole",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to user"
    },
    "role_id": {
      "type": "string",
      "description": "Reference to role"
    },
    "company_id": {
      "type": "string",
      "description": "Reference to company"
    },
    "assigned_by": {
      "type": "string",
      "description": "User who assigned this role"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_to": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
