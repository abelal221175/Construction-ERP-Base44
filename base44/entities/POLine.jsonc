{
  "name": "POLine",
  "type": "object",
  "properties": {
    "po_id": {
      "type": "string",
      "description": "Reference to PO"
    },
    "line_no": {
      "type": "number"
    },
    "pr_line_id": {
      "type": "string",
      "description": "Reference to PR line"
    },
    "product_id": {
      "type": "string"
    },
    "item_description_ar": {
      "type": "string"
    },
    "item_description_en": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "uom_ar": {
      "type": "string"
    },
    "uom_en": {
      "type": "string"
    },
    "unit_price": {
      "type": "number"
    },
    "total_price": {
      "type": "number"
    },
    "received_quantity": {
      "type": "number",
      "default": 0
    },
    "line_status": {
      "type": "string",
      "enum": [
        "pending",
        "partial",
        "complete"
      ],
      "default": "pending"
    }
  },
  "required": [
    "po_id",
    "line_no",
    "quantity",
    "unit_price"
  ]
}