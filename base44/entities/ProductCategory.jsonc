{
  "name": "ProductCategory",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to company"
    },
    "category_code": {
      "type": "string",
      "description": "Unique category code"
    },
    "category_name_ar": {
      "type": "string"
    },
    "category_name_en": {
      "type": "string"
    },
    "parent_category_id": {
      "type": "string",
      "description": "Parent category for hierarchy"
    },
    "full_path": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "category_code",
    "category_name_ar",
    "category_name_en"
  ]
}