{
  "name": "IndirectCostItem",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to company"
    },
    "item_code": {
      "type": "string",
      "description": "Unique item code"
    },
    "item_name_ar": {
      "type": "string"
    },
    "item_name_en": {
      "type": "string"
    },
    "description_ar": {
      "type": "string"
    },
    "description_en": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "administrative",
        "operational",
        "rent",
        "utilities",
        "risk",
        "bank_fees",
        "consultant_fees",
        "accommodation",
        "transport",
        "other"
      ],
      "description": "Category of indirect cost"
    },
    "uom_ar": {
      "type": "string"
    },
    "uom_en": {
      "type": "string"
    },
    "standard_cost": {
      "type": "number"
    },
    "gl_account_id": {
      "type": "string",
      "description": "GL Account for this indirect cost"
    },
    "is_percentage_based": {
      "type": "boolean",
      "default": false,
      "description": "If true, cost is calculated as percentage of total"
    },
    "default_percentage": {
      "type": "number"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "item_code",
    "item_name_ar",
    "item_name_en"
  ]
}