{
  "name": "SystemModule",
  "type": "object",
  "properties": {
    "module_code": {
      "type": "string",
      "description": "Unique module code"
    },
    "module_name_ar": {
      "type": "string",
      "description": "Module name in Arabic"
    },
    "module_name_en": {
      "type": "string",
      "description": "Module name in English"
    },
    "parent_module_id": {
      "type": "string",
      "description": "Parent module for hierarchy"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "icon": {
      "type": "string",
      "description": "Icon name from lucide-react"
    },
    "route_path": {
      "type": "string",
      "description": "Frontend route path"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "module_code",
    "module_name_ar",
    "module_name_en"
  ]
}