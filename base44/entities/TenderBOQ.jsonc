{
  "name": "TenderBOQ",
  "type": "object",
  "properties": {
    "tender_id": {
      "type": "string",
      "description": "Reference to tender"
    },
    "parent_boq_id": {
      "type": "string",
      "description": "Parent BOQ item for hierarchy"
    },
    "level": {
      "type": "number",
      "description": "Level 1-3"
    },
    "system_code": {
      "type": "string"
    },
    "external_code": {
      "type": "string"
    },
    "work_category_id": {
      "type": "string"
    },
    "item_description": {
      "type": "string"
    },
    "brief_description": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "uom": {
      "type": "string"
    },
    "unit_price": {
      "type": "number"
    },
    "total_amount": {
      "type": "number"
    },
    "is_selected": {
      "type": "boolean",
      "default": false
    },
    "has_cost_breakdown": {
      "type": "boolean",
      "default": false
    },
    "cost_estimation_id": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    },
    "sort_order": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tender_id",
    "level",
    "item_description"
  ]
}