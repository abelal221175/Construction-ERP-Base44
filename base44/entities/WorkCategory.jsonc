{
  "name": "WorkCategory",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to company"
    },
    "parent_work_id": {
      "type": "string",
      "description": "Parent work category for hierarchy"
    },
    "work_code": {
      "type": "string",
      "description": "Unique work category code"
    },
    "work_name_ar": {
      "type": "string"
    },
    "work_name_en": {
      "type": "string"
    },
    "level": {
      "type": "number",
      "description": "Level 1-3 in hierarchy"
    },
    "description_ar": {
      "type": "string"
    },
    "description_en": {
      "type": "string"
    },
    "uom_ar": {
      "type": "string"
    },
    "uom_en": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "work_code",
    "work_name_ar",
    "work_name_en",
    "level"
  ]
}