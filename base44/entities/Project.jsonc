{
  "name": "Project",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to company"
    },
    "tender_id": {
      "type": "string",
      "description": "Reference to tender"
    },
    "project_code": {
      "type": "string",
      "description": "Unique project code"
    },
    "project_name_ar": {
      "type": "string",
      "description": "Project name in Arabic"
    },
    "project_name_en": {
      "type": "string",
      "description": "Project name in English"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "external",
        "internal_capex",
        "internal_opex"
      ],
      "description": "Type of project"
    },
    "client_id": {
      "type": "string",
      "description": "Client business partner ID"
    },
    "consultant_id": {
      "type": "string",
      "description": "Consultant business partner ID"
    },
    "contract_number": {
      "type": "string"
    },
    "contract_date": {
      "type": "string",
      "format": "date"
    },
    "original_contract_value": {
      "type": "number"
    },
    "discount_percentage": {
      "type": "number",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "net_contract_value": {
      "type": "number",
      "description": "Calculated: original - discount"
    },
    "variation_amount": {
      "type": "number",
      "default": 0
    },
    "current_contract_value": {
      "type": "number",
      "description": "Calculated: net + variations"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "original_end_date": {
      "type": "string",
      "format": "date"
    },
    "revised_end_date": {
      "type": "string",
      "format": "date"
    },
    "actual_end_date": {
      "type": "string",
      "format": "date"
    },
    "retention_percentage": {
      "type": "number",
      "default": 10
    },
    "advance_payment_percentage": {
      "type": "number",
      "default": 0
    },
    "vat_percentage": {
      "type": "number",
      "default": 14
    },
    "project_manager_id": {
      "type": "string",
      "description": "Project manager employee ID"
    },
    "site_engineer_id": {
      "type": "string",
      "description": "Site engineer employee ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "on_hold",
        "completed",
        "cancelled"
      ],
      "default": "active"
    },
    "progress_percentage": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "company_id",
    "project_code",
    "project_name_ar",
    "project_name_en",
    "client_id",
    "contract_date",
    "original_contract_value",
    "start_date",
    "original_end_date"
  ]
}