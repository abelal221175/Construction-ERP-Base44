{
  "name": "ProjectBOQ",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Reference to project"
    },
    "parent_boq_id": {
      "type": "string",
      "description": "Parent BOQ item for hierarchy"
    },
    "level": {
      "type": "number",
      "description": "Level 1-3 (1=Main Parent, 2=Group, 3=Line Item)"
    },
    "system_code": {
      "type": "string",
      "description": "Auto-generated system code"
    },
    "external_code": {
      "type": "string",
      "description": "External code from consultant"
    },
    "work_category_id": {
      "type": "string",
      "description": "FK to WorkCategory"
    },
    "item_description": {
      "type": "string",
      "description": "Item description (can contain Arabic and English)"
    },
    "brief_description": {
      "type": "string",
      "description": "Short description"
    },
    "quantity": {
      "type": "number",
      "description": "Quantity (Level 3 only)"
    },
    "uom": {
      "type": "string",
      "description": "Unit of measure (can be Arabic or English)"
    },
    "unit_price": {
      "type": "number",
      "description": "Unit price (can be + or -)"
    },
    "total_amount": {
      "type": "number",
      "description": "Calculated: quantity * unit_price"
    },
    "is_selected": {
      "type": "boolean",
      "default": false,
      "description": "Selected for bulk actions"
    },
    "is_selected_for_rfq": {
      "type": "boolean",
      "default": false,
      "description": "Selected for RFQ creation"
    },
    "has_cost_breakdown": {
      "type": "boolean",
      "default": false
    },
    "cost_estimation_id": {
      "type": "string",
      "description": "Link to approved cost estimation"
    },
    "linked_rfq_id": {
      "type": "string"
    },
    "rfq_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "received",
        "priced"
      ],
      "description": "RFQ status for this item"
    },
    "linked_subcontract_id": {
      "type": "string"
    },
    "linked_po_id": {
      "type": "string"
    },
    "template_id": {
      "type": "string",
      "description": "FK to BOQTemplate"
    },
    "cost_center_code": {
      "type": "string"
    },
    "sort_order": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "level",
    "item_description"
  ]
}