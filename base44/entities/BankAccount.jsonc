{
  "name": "BankAccount",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "account_name": {
      "type": "string"
    },
    "bank_id": {
      "type": "string",
      "description": "Bank business partner ID"
    },
    "account_number": {
      "type": "string"
    },
    "iban": {
      "type": "string"
    },
    "swift_code": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "EGP"
    },
    "gl_account_id": {
      "type": "string"
    },
    "current_balance": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "company_id",
    "account_name",
    "account_number"
  ]
}